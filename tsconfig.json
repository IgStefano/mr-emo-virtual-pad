{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/domain/**/*.ts",
    "tests/contracts/**/*.ts",
    "tests/storage/**/*.ts",
    "tests/playback/**/*.ts",
    "tests/electron/**/*.ts"
  ]
}
