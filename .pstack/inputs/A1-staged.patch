index 0000000..4f9c940
--- /dev/null
+++ b/src/main/storage/catalog-store.ts
@@ -0,0 +1,114 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomUUID } from 'node:crypto';
+import { z } from 'zod';
+import { catalogSchema, repertoireIdSchema } from '../../contracts/catalog';
+import type { Catalog } from '../../contracts/catalog';
+import { ErrorCode } from '../../contracts/operations';
+
+export class CatalogFault extends Error {
+  constructor(readonly code: (typeof ErrorCode)[keyof typeof ErrorCode]) {
+    super(code);
+  }
+}
+
+export class CatalogStore {
+  private readonly db: DatabaseSync;
+
+  constructor(path: string) {
+    try {
+      this.db = new DatabaseSync(path);
+    } catch {
+      throw new CatalogFault(ErrorCode.CorruptCatalog);
+    }
+    try {
+      this.db.exec('PRAGMA foreign_keys = ON');
+      const version = z
+        .object({ user_version: z.number() })
+        .parse(this.db.prepare('PRAGMA user_version').get()).user_version;
+      if (version > 1) throw new CatalogFault(ErrorCode.FutureSchema);
+      if (version === 0) {
+        this.db.exec('BEGIN IMMEDIATE');
+        try {
+          this.db.exec(
+            'CREATE TABLE catalog (id INTEGER PRIMARY KEY CHECK(id = 1), data TEXT NOT NULL); CREATE TABLE cleanup (name TEXT PRIMARY KEY); PRAGMA user_version = 1',
+          );
+          const initial: Catalog = {
+            schemaVersion: 1,
+            revision: 0,
+            assets: [],
+            pads: [],
+            repertoire: {
+              id: repertoireIdSchema.parse(randomUUID()),
+              name: 'Repertoire',
+              padIds: [],
+            },
+          };
+          this.db
+            .prepare('INSERT INTO catalog VALUES (1, ?)')
+            .run(JSON.stringify(initial));
+          this.db.exec('COMMIT');
+        } catch (error) {
+          this.db.exec('ROLLBACK');
+          throw error;
+        }
+      }
+      this.read();
+    } catch (error) {
+      this.db.close();
+      if (error instanceof CatalogFault) throw error;
+      throw new CatalogFault(ErrorCode.CorruptCatalog);
+    }
+  }
+
+  read(): Catalog {
+    try {
+      const row = z
+        .object({ data: z.string() })
+        .parse(this.db.prepare('SELECT data FROM catalog WHERE id = 1').get());
+      const catalog = catalogSchema.parse(JSON.parse(row.data));
+      const assets = new Set(catalog.assets.map((asset) => asset.id));
+      const pads = new Set(catalog.pads.map((pad) => pad.id));
+      if (
+        assets.size !== catalog.assets.length ||
+        pads.size !== catalog.pads.length ||
+        catalog.pads.some((pad) => !assets.has(pad.assetId)) ||
+        catalog.repertoire.padIds.length !== pads.size ||
+        new Set(catalog.repertoire.padIds).size !== pads.size ||
+        catalog.repertoire.padIds.some((id) => !pads.has(id))
+      )
+        throw new CatalogFault(ErrorCode.CorruptCatalog);
+      return catalog;
+    } catch {
+      throw new CatalogFault(ErrorCode.CorruptCatalog);
+    }
+  }
+
+  commit(catalog: Catalog, cleanup: string[] = []): void {
+    this.db.exec('BEGIN IMMEDIATE');
+    try {
+      this.db
+        .prepare('UPDATE catalog SET data = ? WHERE id = 1')
+        .run(JSON.stringify(catalogSchema.parse(catalog)));
+      for (const name of cleanup)
+        this.db.prepare('INSERT OR IGNORE INTO cleanup VALUES (?)').run(name);
+      this.db.exec('COMMIT');
+    } catch (error) {
+      this.db.exec('ROLLBACK');
+      throw error;
+    }
+  }
+
+  pending(): string[] {
+    return z
+      .array(z.object({ name: z.uuid() }))
+      .parse(this.db.prepare('SELECT name FROM cleanup').all())
+      .map((row) => row.name);
+  }
+
+  cleaned(name: string): void {
+    this.db.prepare('DELETE FROM cleanup WHERE name = ?').run(name);
+  }
+  close(): void {
+    this.db.close();
+  }
+}
diff --git a/src/main/storage/managed-catalog.ts b/src/main/storage/managed-catalog.ts
new file mode 100644
index 0000000..da29d0a
--- /dev/null
+++ b/src/main/storage/managed-catalog.ts
@@ -0,0 +1,184 @@
+import {
+  copyFileSync,
+  mkdirSync,
+  readdirSync,
+  renameSync,
+  rmSync,
+  statSync,
+} from 'node:fs';
+import { join, basename } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { assetIdSchema, padIdSchema, PadColor } from '../../contracts/catalog';
+import type { Catalog } from '../../contracts/catalog';
+import {
+  deletePadSchema,
+  editRequestSchema,
+  ErrorCode,
+  reorderPadsSchema,
+  updatePadSchema,
+} from '../../contracts/operations';
+import type { CatalogOperations, Lease } from '../../contracts/operations';
+import { CatalogFault, CatalogStore } from './catalog-store';
+
+type EditRequest = Parameters<CatalogOperations['importAudio']>[0];
+export interface LibraryDependencies {
+  assertEditLease: (lease: Lease) => void;
+  selectFiles: () => Promise<string[]>;
+  validateAudio: (path: string) => Promise<{ durationSeconds: number }>;
+}
+
+export class ManagedCatalog implements CatalogOperations {
+  private readonly store: CatalogStore;
+  private busy = false;
+  constructor(
+    private readonly root: string,
+    private readonly dependencies: LibraryDependencies,
+  ) {
+    mkdirSync(join(root, 'media'), { recursive: true });
+    mkdirSync(join(root, 'staging'), { recursive: true });
+    this.store = new CatalogStore(join(root, 'catalog.sqlite'));
+  }
+
+  getCatalog = (): Promise<Catalog> => Promise.resolve(this.store.read());
+
+  private async edit(
+    request: EditRequest,
+    action: (catalog: Catalog) => Promise<Catalog>,
+  ): Promise<Catalog> {
+    this.dependencies.assertEditLease(request.lease);
+    if (this.busy) throw new CatalogFault(ErrorCode.Busy);
+    this.busy = true;
+    try {
+      const catalog = this.store.read();
+      if (catalog.revision !== request.expectedRevision)
+        throw new CatalogFault(ErrorCode.StaleRevision);
+      return await action(catalog);
+    } finally {
+      this.busy = false;
+    }
+  }
+
+  importAudio = async (input: EditRequest): Promise<Catalog> => {
+    const request = editRequestSchema.parse(input);
+    return this.edit(request, async (catalog) => {
+      const files = await this.dependencies.selectFiles();
+      for (const source of files) {
+        const id = assetIdSchema.parse(randomUUID());
+        const staged = join(this.root, 'staging', id);
+        copyFileSync(source, staged);
+        const audio = await this.dependencies.validateAudio(staged);
+        if (
+          !Number.isFinite(audio.durationSeconds) ||
+          audio.durationSeconds <= 0
+        )
+          throw new CatalogFault(ErrorCode.UnsupportedFormat);
+        this.dependencies.assertEditLease(request.lease);
+        renameSync(staged, join(this.root, 'media', id));
+        const padId = padIdSchema.parse(randomUUID());
+        catalog.assets.push({
+          id,
+          name: basename(source),
+          durationSeconds: audio.durationSeconds,
+        });
+        catalog.pads.push({
+          id: padId,
+          assetId: id,
+          label: basename(source),
+          color: PadColor.Slate,
+        });
+        catalog.repertoire.padIds.push(padId);
+      }
+      this.dependencies.assertEditLease(request.lease);
+      catalog.revision++;
+      this.store.commit(catalog);
+      return catalog;
+    });
+  };
+
+  updatePad: CatalogOperations['updatePad'] = async (input) => {
+    const request = updatePadSchema.parse(input);
+    return this.edit(request, (catalog) => {
+      const pad = catalog.pads.find((item) => item.id === request.padId);
+      if (!pad) throw new CatalogFault(ErrorCode.NotFound);
+      pad.label = request.label;
+      pad.color = request.color;
+      catalog.revision++;
+      this.store.commit(catalog);
+      return Promise.resolve(catalog);
+    });
+  };
+
+  reorderPads: CatalogOperations['reorderPads'] = async (input) => {
+    const request = reorderPadsSchema.parse(input);
+    return this.edit(request, (catalog) => {
+      if (
+        request.padIds.length !== catalog.pads.length ||
+        new Set(request.padIds).size !== catalog.pads.length ||
+        request.padIds.some((id) => !catalog.pads.some((pad) => pad.id === id))
+      )
+        throw new CatalogFault(ErrorCode.InvalidRequest);
+      catalog.repertoire.padIds = request.padIds;
+      catalog.revision++;
+      this.store.commit(catalog);
+      return Promise.resolve(catalog);
+    });
+  };
+
+  deletePad: CatalogOperations['deletePad'] = async (input) => {
+    const request = deletePadSchema.parse(input);
+    return this.edit(request, (catalog) => {
+      const pad = catalog.pads.find((item) => item.id === request.padId);
+      if (!pad) throw new CatalogFault(ErrorCode.NotFound);
+      catalog.pads = catalog.pads.filter((item) => item.id !== pad.id);
+      catalog.repertoire.padIds = catalog.repertoire.padIds.filter(
+        (id) => id !== pad.id,
+      );
+      const unused = !catalog.pads.some((item) => item.assetId === pad.assetId);
+      if (unused)
+        catalog.assets = catalog.assets.filter(
+          (asset) => asset.id !== pad.assetId,
+        );
+      catalog.revision++;
+      this.store.commit(catalog, unused ? [pad.assetId] : []);
+      this.cleanup();
+      return Promise.resolve(catalog);
+    });
+  };
+
+  private cleanup(): void {
+    try {
+      for (const name of this.store.pending()) {
+        rmSync(join(this.root, 'media', name), { force: true });
+        this.store.cleaned(name);
+      }
+    } catch {
+      throw new CatalogFault(ErrorCode.CleanupRequired);
+    }
+  }
+
+  recover(lease: Lease): void {
+    this.dependencies.assertEditLease(lease);
+    if (this.busy) throw new CatalogFault(ErrorCode.Busy);
+    this.cleanup();
+    const catalog = this.store.read();
+    const referenced = new Set<string>(catalog.assets.map((asset) => asset.id));
+    for (const name of readdirSync(join(this.root, 'staging')))
+      rmSync(join(this.root, 'staging', name), { force: true });
+    for (const name of readdirSync(join(this.root, 'media'))) {
+      if (!referenced.has(name))
+        rmSync(join(this.root, 'media', name), { force: true });
+    }
+    for (const asset of catalog.assets) {
+      try {
+        if (!statSync(join(this.root, 'media', asset.id)).isFile())
+          throw new Error();
+      } catch {
+        throw new CatalogFault(ErrorCode.CorruptCatalog);
+      }
+    }
+  }
+
+  close(): void {
+    this.store.close();
+  }
+}
diff --git a/tests/storage/catalog.test.ts b/tests/storage/catalog.test.ts
new file mode 100644
index 0000000..83b93bc
--- /dev/null
+++ b/tests/storage/catalog.test.ts
@@ -0,0 +1,183 @@
+import {
+  mkdtempSync,
+  writeFileSync,
+  readFileSync,
+  rmSync,
+  mkdirSync,
+} from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { DatabaseSync } from 'node:sqlite';
+import { afterEach, expect, it } from 'vitest';
+import { ManagedCatalog } from '../../src/main/library/managed-catalog';
+import { editRequestSchema } from '../../src/contracts/operations';
+import type { Lease } from '../../src/contracts/operations';
+import { CatalogStore } from '../../src/main/storage/catalog-store';
+
+const roots: string[] = [];
+afterEach(() => {
+  for (const root of roots) rmSync(root, { recursive: true, force: true });
+});
+function setup() {
+  const root = mkdtempSync(join(tmpdir(), 'pad-'));
+  roots.push(root);
+  const source = join(root, 'original');
+  writeFileSync(source, 'audio bytes');
+  const lease = editRequestSchema.shape.lease.parse({
+    sessionId: randomUUID(),
+    leaseId: randomUUID(),
+    attemptId: 1,
+    kind: 'edit',
+  });
+  const dependencies = {
+    assertEditLease: (given: Lease) => {
+      if (given !== lease && given.leaseId !== lease.leaseId)
+        throw new Error('unauthorized');
+    },
+    selectFiles: () => Promise.resolve([source]),
+    validateAudio: () => Promise.resolve({ durationSeconds: 12 }),
+  };
+  return { root, source, lease, dependencies };
+}
+
+it('persists 31 pads, labels, colors, ordering and managed bytes across restart', async () => {
+  const f = setup();
+  f.dependencies.selectFiles = () =>
+    Promise.resolve(Array<string>(31).fill(f.source));
+  let library = new ManagedCatalog(f.root, f.dependencies);
+  let catalog = await library.importAudio({
+    lease: f.lease,
+    expectedRevision: 0,
+  });
+  expect(catalog.pads).toHaveLength(31);
+  const pad = catalog.pads.at(0);
+  if (!pad) throw new Error('missing pad');
+  catalog = await library.updatePad({
+    lease: f.lease,
+    expectedRevision: 1,
+    padId: pad.id,
+    label: 'Intro',
+    color: 'red',
+  });
+  catalog = await library.reorderPads({
+    lease: f.lease,
+    expectedRevision: 2,
+    padIds: [...catalog.repertoire.padIds].reverse(),
+  });
+  rmSync(f.source);
+  library.close();
+  library = new ManagedCatalog(f.root, f.dependencies);
+  expect(await library.getCatalog()).toEqual(catalog);
+  expect(readFileSync(join(f.root, 'media', pad.assetId), 'utf8')).toBe(
+    'audio bytes',
+  );
+  library.recover(f.lease);
+  library.close();
+});
+
+it('keeps deletion cleanup durable when unlink fails and retries on restart', async () => {
+  const f = setup();
+  let library = new ManagedCatalog(f.root, f.dependencies);
+  const catalog = await library.importAudio({
+    lease: f.lease,
+    expectedRevision: 0,
+  });
+  const pad = catalog.pads.at(0);
+  if (!pad) throw new Error('missing pad');
+  const path = join(f.root, 'media', pad.assetId);
+  rmSync(path);
+  mkdirSync(path);
+  await expect(
+    library.deletePad({ lease: f.lease, expectedRevision: 1, padId: pad.id }),
+  ).rejects.toMatchObject({ code: 'cleanup-required' });
+  expect((await library.getCatalog()).pads).toEqual([]);
+  library.close();
+  rmSync(path, { recursive: true });
+  library = new ManagedCatalog(f.root, f.dependencies);
+  library.recover(f.lease);
+  expect(readFileSync(f.source, 'utf8')).toBe('audio bytes');
+  library.close();
+});
+
+it('never publishes failed copies or invalid audio and recovers staged files', async () => {
+  const f = setup();
+  const library = new ManagedCatalog(f.root, f.dependencies);
+  rmSync(f.source);
+  await expect(
+    library.importAudio({ lease: f.lease, expectedRevision: 0 }),
+  ).rejects.toThrow();
+  writeFileSync(f.source, 'bad');
+  f.dependencies.validateAudio = () => Promise.resolve({ durationSeconds: 0 });
+  await expect(
+    library.importAudio({ lease: f.lease, expectedRevision: 0 }),
+  ).rejects.toMatchObject({ code: 'unsupported-format' });
+  expect((await library.getCatalog()).revision).toBe(0);
+  library.recover(f.lease);
+  library.close();
+});
+
+it('reports missing media, corruption and future versions without reset', async () => {
+  const f = setup();
+  const library = new ManagedCatalog(f.root, f.dependencies);
+  const catalog = await library.importAudio({
+    lease: f.lease,
+    expectedRevision: 0,
+  });
+  for (const asset of catalog.assets) rmSync(join(f.root, 'media', asset.id));
+  expect(() => {
+    library.recover(f.lease);
+  }).toThrow('corrupt-catalog');
+  library.close();
+  const path = join(f.root, 'catalog.sqlite');
+  const db = new DatabaseSync(path);
+  db.exec('PRAGMA user_version = 2');
+  db.close();
+  expect(() => new CatalogStore(path)).toThrow('future-schema');
+  writeFileSync(path, 'invalid database');
+  expect(() => new CatalogStore(path)).toThrow('corrupt-catalog');
+  expect(readFileSync(path, 'utf8')).toBe('invalid database');
+});
+
+it('rolls back publication on SQL failure and removes promoted orphans on recovery', async () => {
+  const f = setup();
+  const library = new ManagedCatalog(f.root, f.dependencies);
+  const db = new DatabaseSync(join(f.root, 'catalog.sqlite'));
+  db.exec(
+    "CREATE TRIGGER fail_commit BEFORE UPDATE ON catalog BEGIN SELECT RAISE(ABORT, 'disk failure'); END",
+  );
+  await expect(
+    library.importAudio({ lease: f.lease, expectedRevision: 0 }),
+  ).rejects.toThrow('disk failure');
+  expect((await library.getCatalog()).assets).toEqual([]);
+  library.recover(f.lease);
+  db.close();
+  library.close();
+});
+
+it('reserves edits across selection and rejects stale revisions and revoked leases', async () => {
+  const f = setup();
+  let finish: (files: string[]) => void = () => {
+    throw new Error('not waiting');
+  };
+  f.dependencies.selectFiles = () =>
+    new Promise<string[]>((resolve) => {
+      finish = resolve;
+    });
+  const library = new ManagedCatalog(f.root, f.dependencies);
+  const pending = library.importAudio({ lease: f.lease, expectedRevision: 0 });
+  await expect(
+    library.importAudio({ lease: f.lease, expectedRevision: 0 }),
+  ).rejects.toMatchObject({ code: 'busy' });
+  f.dependencies.assertEditLease = () => {
+    throw new Error('revoked');
+  };
+  finish([f.source]);
+  await expect(pending).rejects.toThrow('revoked');
+  f.dependencies.assertEditLease = () => undefined;
+  expect((await library.getCatalog()).revision).toBe(0);
+  await expect(
+    library.reorderPads({ lease: f.lease, expectedRevision: 10, padIds: [] }),
+  ).rejects.toMatchObject({ code: 'stale-revision' });
+  library.close();
+});
